# /etc/systemd/system/skereru.service
[Unit]
Description=skereru mail server
After=network-online.target
Wants=network-online.target

[Service]
User=skereru
Group=skereru
EnvironmentFile=/etc/skereru/skereru.env
ExecStart=/usr/bin/java -Xms512m -Xmx2g -cp '/opt/skereru/current/lib/*' skereru.app.Main
# 停止時は処理中の接続を少し待ってから終わる（他ノードがそのまま受ける）
TimeoutStopSec=20
Restart=on-failure
RestartSec=3
# 特権ポート（25・587・993 など）は HAProxy が受け、アプリは 2525 などの高いポートで待ち受ける（root 不要）
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
# TLS の証明書（Let's Encrypt）は読み取りだけ
ReadOnlyPaths=/etc/skereru /etc/letsencrypt

[Install]
WantedBy=multi-user.target
