# /etc/default/etcd（例: skereru1。3台で名前とIPだけ変える）
# etcd は Patroni のリーダーを決める。書き換えられると不正な昇格・スプリットブレインになるため、
# ピア・クライアントとも TLS とクライアント証明書で守り、ユーザー認証も有効にする（下の「認証の有効化」）。
ETCD_NAME=skereru1
ETCD_DATA_DIR=/var/lib/etcd
ETCD_LISTEN_PEER_URLS=https://10.0.0.11:2380
ETCD_LISTEN_CLIENT_URLS=https://10.0.0.11:2379,https://127.0.0.1:2379
ETCD_INITIAL_ADVERTISE_PEER_URLS=https://10.0.0.11:2380
ETCD_ADVERTISE_CLIENT_URLS=https://10.0.0.11:2379
ETCD_INITIAL_CLUSTER=skereru1=https://10.0.0.11:2380,skereru2=https://10.0.0.12:2380,skereru3=https://10.0.0.13:2380
ETCD_INITIAL_CLUSTER_STATE=new
ETCD_INITIAL_CLUSTER_TOKEN=skereru-etcd
ETCD_CERT_FILE=/etc/etcd/tls/node.crt
ETCD_KEY_FILE=/etc/etcd/tls/node.key
ETCD_TRUSTED_CA_FILE=/etc/etcd/tls/ca.crt
ETCD_CLIENT_CERT_AUTH=true
ETCD_PEER_CERT_FILE=/etc/etcd/tls/node.crt
ETCD_PEER_KEY_FILE=/etc/etcd/tls/node.key
ETCD_PEER_TRUSTED_CA_FILE=/etc/etcd/tls/ca.crt
ETCD_PEER_CLIENT_CERT_AUTH=true
# 認証の有効化（クラスタを作った後に1度だけ。patroni ユーザーのパスワードは patroni.yml の etcd3.password と同じ）:
#   etcdctl user add root ; etcdctl user add patroni ; etcdctl role add patroni
#   etcdctl role grant-permission patroni --prefix=true readwrite /service/ ; etcdctl user grant-role patroni patroni
#   etcdctl auth enable
