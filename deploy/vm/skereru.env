# /etc/skereru/skereru.env （各ノードで NODE_ID だけ変える。権限 0600, 所有者 skereru）
# DB への接続は TLS（証明書の名前まで確かめる）
DATABASE_URL=jdbc:postgresql://10.0.0.11:5432,10.0.0.12:5432,10.0.0.13:5432/skereru?targetServerType=primary&connectTimeout=3&tcpKeepAlive=true&sslmode=verify-full&sslrootcert=/etc/skereru/tls/ca.crt
DATABASE_USER=skereru
DATABASE_PASSWORD=change-me
OIDC_ISSUER=https://auth.example.com/application/o/skereru/
OIDC_CLIENT_ID=change-me
OIDC_CLIENT_SECRET=change-me
ADMIN_GROUPS=skereru-admins
PUBLIC_URL=https://mail.example.com
STATIC_DIR=/opt/skereru/current/static
HTTP_PORT=8080
NODE_ID=skereru1
# 秘密の値の暗号化（DKIM の鍵・保存したメッセージ）。全ノード共通、32文字以上を推奨。変えると保存済みのメールを読めなくなる
# 例: openssl rand -base64 48 。change-me のままでは起動しない
APP_SECRET=change-me
TIMEZONE=Asia/Tokyo
# メール（HELO・バナー・MX の名前。証明書の名前と合わせる）
MAIL_HOSTNAME=mail.example.com
TLS_CERT=/etc/letsencrypt/live/mail.example.com/fullchain.pem
TLS_KEY=/etc/letsencrypt/live/mail.example.com/privkey.pem
# HAProxy が公開のポートで受けて、ここへ PROXY プロトコルで渡す
SMTP_PORT=2525
SUBMISSION_PORT=2587
SMTPS_PORT=2465
IMAP_PORT=2143
IMAPS_PORT=2993
POP3_PORT=2110
POP3S_PORT=2995
# PROXY プロトコル・X-Forwarded-For を信じるのは HAProxy（各ノード）だけ。サブネット全体にすると、ほかの機械から接続元を偽れる
# アプリのポート（8080・2525 など）も FW で HAProxy からだけに絞る
PROXY_PROTOCOL_FROM=10.0.0.11/32,10.0.0.12/32,10.0.0.13/32
TRUSTED_PROXIES=10.0.0.11/32,10.0.0.12/32,10.0.0.13/32
# 迷惑メール（DNSBL は利用条件を確認して設定する。Spamhaus は公開の DNS リゾルバー経由では使えない）
DNS_SERVERS=127.0.0.1
DNSBL_ZONES=
SPAM_JUNK_SCORE=5
SPAM_REJECT_SCORE=15
# ClamAV（任意）
#CLAMAV=127.0.0.1:3310
MAX_MESSAGE_MB=50
DEFAULT_QUOTA_MB=10240
MTA_STS_MODE=testing
# 外への送信をほかの SMTP サーバーに中継するとき（ポート25が使えない環境）
#RELAY_HOST=smtp.relay.example
#RELAY_PORT=587
#RELAY_TLS=starttls
#RELAY_USER=
#RELAY_PASSWORD=
